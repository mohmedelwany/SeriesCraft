ARG PHP_VERSION=8.2
FROM php:${PHP_VERSION}-cli

# ── System dependencies ─────────────────────────────────────────────────────
RUN apt-get update && apt-get install -y \
    unzip \
    git \
    curl \
    subversion \
    mariadb-client \
    libzip-dev \
    && docker-php-ext-install mysqli zip \
    && rm -rf /var/lib/apt/lists/*

# ── Composer binary ─────────────────────────────────────────────────────────
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

# ── WP-CLI ──────────────────────────────────────────────────────────────────
RUN curl -o /usr/local/bin/wp \
    https://raw.githubusercontent.com/wp-cli/builds/gh-pages/phar/wp-cli.phar \
    && chmod +x /usr/local/bin/wp

RUN wp --info --allow-root

WORKDIR /app

# ── Stage 1: Plugin autoloader (src/vendor) ─────────────────────────────────
# Copy only the plugin's own composer manifests so this layer is cached
# separately from the test-tool layer below.
COPY src/composer.json src/composer.lock src/
RUN cd src && composer install --no-dev --no-interaction --prefer-dist --no-progress

# ── Stage 2: Test tooling (phpunit only) ────────────────────────────────────
# Uses docker/integration/composer.json — intentionally lean, no linting tools,
# so it works on every PHP version we test against (7.4 – 8.3).
COPY docker/integration/composer.json ./
RUN composer install --no-interaction --prefer-dist --no-progress

# ── Copy remaining source code + tests ──────────────────────────────────────
COPY . .

# Ensure all shell scripts are executable (handles clean checkouts where
# the execute bit may not be preserved by git on some systems).
RUN chmod +x \
    docker/integration/entrypoint.sh \
    docker/integration/install-wp-tests.sh \
    bin/test-integration-matrix.sh

WORKDIR /app
