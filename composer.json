{
    "name": "mohmedelwany/series-craft-dev",
    "description": "Development environment for Series Craft plugin",
    "type": "project",
    "license": "GPL-3.0-or-later",
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6 || ^10.0",
        "squizlabs/php_codesniffer": "^3.7",
        "wp-coding-standards/wpcs": "^3.0",
        "phpstan/phpstan": "^1.10",
        "slevomat/coding-standard": "^8.0",
        "phpcompatibility/php-compatibility": "^10.0-dev",
        "automattic/vipwpcs": "^3.0",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "SeriesCraft\\": "src/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SeriesCraft\\Tests\\Integration\\": "tests/Integration/",
            "SeriesCraft\\Tests\\Unit\\": "tests/Unit/"
        }
    },
    "scripts": {
        "lint": "vendor/bin/phpcs src --standard=phpcs.xml",
        "lint:fix": "vendor/bin/phpcbf src --standard=phpcs.xml",
        "lint:security": "vendor/bin/phpcs src --standard=phpcs_sec.xml",
        "test": "vendor/bin/phpunit -c phpunit.xml.dist",
        "test:unit": "vendor/bin/phpunit -c phpunit.xml.dist",
        "test:integration": "vendor/bin/phpunit -c phpunit.integration.xml",
        "test:matrix": "bash bin/test-integration-matrix.sh",
        "stan": "vendor/bin/phpstan analyze src"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "process-timeout": 0
    }
}