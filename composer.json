{
    "name": "mohmedelwany/series-craft-dev",
    "description": "Development environment for Series Craft plugin",
    "type": "project",
    "license": "GPL-3.0-or-later",
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "squizlabs/php_codesniffer": "^3.7",
        "wp-coding-standards/wpcs": "^3.0",
        "phpstan/phpstan": "^1.10",
        "slevomat/coding-standard": "^8.0"
    },
    "scripts": {
        "lint": "phpcs src --standard=phpcs.xml",
        "lint:fix": "phpcbf src --standard=phpcs.xml",
        "test": "phpunit",
        "stan": "phpstan analyze src"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
