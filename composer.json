{
    "name": "mohmedelwany/series-craft-dev",
    "description": "Development environment for Series Craft plugin",
    "type": "project",
    "license": "GPL-3.0-or-later",
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "squizlabs/php_codesniffer": "^3.7",
        "wp-coding-standards/wpcs": "^3.0",
        "phpstan/phpstan": "^1.10",
        "slevomat/coding-standard": "^8.0",
        "phpcompatibility/php-compatibility": "^10.0-dev"
    },
    "scripts": {
        "lint": "phpcs src --standard=phpcs.xml",
        "lint:fix": "phpcbf src --standard=phpcs.xml",
        "test": "phpunit -c phpunit.xml.dist",
        "test:unit": "phpunit -c phpunit.xml.dist",
        "test:integration": "phpunit -c phpunit.integration.xml",
        "test:matrix": "bash bin/test-integration-matrix.sh",
        "stan": "phpstan analyze src"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "process-timeout": 0
    }
}
