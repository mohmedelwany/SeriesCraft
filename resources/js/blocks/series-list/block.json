{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "seriescraft/series-list",
  "title": "Series List",
  "category": "widgets",
  "description": "Display series based on different modes.",
  "icon": "list-view",
  "supports": {
    "html": false
  },
  "editorStyle": "seriescraft-editor-style",
  "attributes": {
    "align": {
      "type": "string",
      "default": "wide"
    },
    "mode": {
      "type": "string",
      "default": "all"
    },
    "limit": {
      "type": "number",
      "default": 5
    },
    "userId": {
      "type": "string",
      "default": ""
    }
  }
}
